generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id        String    @id @default(cuid())
  name      String    @unique
  capacity  Int
  building  String
  floor     String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Employee {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  department String
  status     String    @default("active")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookings   Booking[]
}

model Booking {
  id            String         @id @default(cuid())
  roomId        String
  room          Room           @relation(fields: [roomId], references: [id])
  // Nullable (ticket 12, PDPA erasure-on-request): §5.5 of the data
  // requirements is explicit that erasure nulls out employeeId AND title on
  // every affected Booking (both past and future), then deletes the
  // Employee row — DR-04's "always references exactly one Employee" is
  // superseded for erased rows by the mandatory NFR-PDPA-05 (30-day erasure
  // deadline). room/startAt/endAt/attendeeCount stay intact for anonymous
  // statistics (NFR-PDPA-07).
  employeeId    String?
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  title         String?
  attendeeCount Int
  startAt       DateTime
  endAt         DateTime
  status        String         @default("confirmed")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditEntries  BookingAudit[]

  // Room usage calendar (FR-BKG-03, ticket 10) filters on a startAt range
  // for every query — without this, that scan grows with total historical
  // booking count instead of the day's actual row count.
  @@index([startAt])
}

model BookingAudit {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  action          String
  // Not a FK to Employee (per DR-03 data dictionary): this is a snapshot of
  // the self-reported employeeId at the time of the action (CON-03), not a
  // verified identity, and must survive independently of the Employee row
  // for PDPA erasure (DR-09/DR-11).
  actorEmployeeId String
  detail          String?
  actedAt         DateTime @default(now())

  @@index([bookingId])
}

model BusinessHours {
  dayOfWeek Int      @id
  openTime  String
  closeTime String
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

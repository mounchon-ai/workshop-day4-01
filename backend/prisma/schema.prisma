generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Room {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  building  String
  floor     String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  department String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BusinessHours {
  dayOfWeek Int      @id
  openTime  String
  closeTime String
  isOpen    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
